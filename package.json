{
  "name": "order-system",
  "version": "0.1.0",
  "private": true,
  "description": "Reference implementation for order processing and distributed systems",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "db:migrate": "node --env-file-if-exists=.env packages/database/scripts/migrate.js development",
    "db:migrate:test": "node --env-file-if-exists=.env packages/database/scripts/migrate.js test",
    "experiment:distributed-lock": "node packages/experiments/src/cli.js distributed-lock",
    "experiment:idempotency": "node packages/experiments/src/cli.js idempotency",
    "experiment:optimistic-lock": "node packages/experiments/src/cli.js optimistic-lock",
    "experiment:pessimistic-lock": "node packages/experiments/src/cli.js pessimistic-lock",
    "experiment:race-condition": "node packages/experiments/src/cli.js race-condition",
    "start:api": "npm run start --workspace @order-system/api",
    "test": "npm run test:unit && npm run db:migrate:test && npm run test:integration",
    "test:integration": "node --env-file-if-exists=.env --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.integration.config.js --runInBand --passWithNoTests",
    "test:unit": "node --env-file-if-exists=.env --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.unit.config.js --runInBand --passWithNoTests"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6"
  }
}
